name = "flood-transbulent"
main = "build/worker/shim.mjs"
account_id = "00000000000000000000000000000000"
compatibility_date = "2026-09-01"
workers_dev = false
preview_urls = false

routes = [
  { pattern = "flood.example.com/*", zone_name = "example.com" },
  { pattern = "flood.example.com", custom_domain = true }
]

[build]
command = "worker-build --release"

[assets]
directory = "../flood-web/dist"
binding = "ASSETS"
run_worker_first = true
not_found_handling = "single-page-application"

[durable_objects]
bindings = [
  { name = "FLOOD_HUB", class_name = "FloodHub" }
]

[[migrations]]
tag = "v1"
new_sqlite_classes = ["FloodHub"]

[triggers]
crons = ["*/15 * * * *"]
